{
	"name": "docs",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": [ "global_fetch_strictly_public" ],
	"observability": {
    "logs": {
      "enabled": true
    },
    "traces": {
      "enabled": true
    },
    "issues": {
      "enabled": true
    }
  },
  "workers_dev": false,
  "preview_urls": true,
  "keep_vars": true,
  "routes": [
    {
      "pattern": "docs.fossbilling.org",
      "zone_name": "fossbilling.org",
      "custom_domain": true
    }
  ],
	"assets": {
		"directory": "./dist"
	},
  "previews": {}
}

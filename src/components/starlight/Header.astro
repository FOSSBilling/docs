---
import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
---

<div class="fb-header">
  <div class="fb-header__brand">
    <SiteTitle />
    <span class="fb-header__title">Docs</span>
  </div>

  <div class="fb-header__tools">
    <div class="fb-header__search">
      <Search />
    </div>

    <div class="fb-header__actions">
      <div class="fb-header__social">
        <SocialIcons />
      </div>
      <ThemeSelect />
      <LanguageSelect />
    </div>
  </div>
</div>

<style>
  .fb-header {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 0.75rem;
    height: auto;
  }

  .fb-header__brand {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    min-width: 0;
    width: 100%;
    overflow: clip;
    padding: 0.25rem;
    margin: -0.25rem;
  }

  .fb-header__title {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    border-inline-start: 1px solid var(--sl-color-gray-5);
    padding-inline-start: 0.875rem;
    color: var(--sl-color-gray-2);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .fb-header__tools {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.75rem;
    width: 100%;
  }

  .fb-header__search {
    min-width: 0;
  }

  .fb-header__social {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .fb-header__actions {
    display: none;
  }

  @media (min-width: 50rem) {
    .fb-header {
      display: grid;
      grid-template-columns: minmax(0, auto) minmax(0, 1fr);
      gap: 1rem 1.25rem;
      height: 100%;
    }

    .fb-header__tools {
      grid-template-columns: minmax(14rem, 22rem) auto;
      align-items: center;
      justify-content: end;
      justify-self: end;
      width: auto;
      max-width: 100%;
    }

    .fb-header__actions {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .fb-header__social {
      padding-inline-end: 0.875rem;
      border-inline-end: 1px solid var(--sl-color-gray-5);
    }
  }
</style>

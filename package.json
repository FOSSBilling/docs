    "typescript": "6.0.3"
  },
  "dependencies": {
    "@astrojs/markdoc": "^2.0.0",
    "@astrojs/starlight": "^0.43.0",
    "@astrojs/starlight-markdoc": "^0.7.0",
    "astro": "^7.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true,
    "workerd": true
